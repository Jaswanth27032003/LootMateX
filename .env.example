# Every environment variable the site reads. Copy to .env.local for local dev,
# and set the same names in Vercel → Project → Settings → Environment Variables.
# All are optional; values are baked in at build time, so redeploy after changing them.

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Empty = analytics off.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public site URL for canonical links, Open Graph tags and sitemap.xml, no trailing slash.
# Leave empty on Vercel to use the project's production domain automatically;
# set it once you add a custom domain (e.g. https://www.yourdomain.com).
NEXT_PUBLIC_SITE_URL=
